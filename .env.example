# Google Cloud Platform Configuration
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1

# GitHub App Integration & Tool Authentication
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=7891011
GITHUB_TOKEN=ghp_example_personal_access_token_or_app_token
GITHUB_REPOSITORY=owner/repository-name

# Google Agent Development Kit (ADK) Runtime Environment
ADK_LOG_LEVEL=INFO
ADK_MAX_ITERATIONS=3
ADK_CIRCUIT_BREAKER_THRESHOLD=3

# Secret Manager Keys (Optional override IDs)
GITHUB_SECRET_ID=github-app-private-key
API_KEY_SECRET_ID=gemini-api-key
